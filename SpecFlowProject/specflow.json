{
  "specFlow": {
    "bindingCulture": { "name": "en-US" }
  },
  "Selenium": {
    "Browser": "Chrome",
    "Headless": true,
    "Arguments": [
      "--no-sandbox",
      "--disable-dev-shm-usage",
      "--headless=new",
      "--remote-debugging-port=9222",
      "--disable-gpu",
      "--window-size=1920,1080"
    ]
  }
}
